name: Creation of ISO

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - run: sudo apt update && sudo apt install -y xorriso isolinux squashfs-tools libarchive-dev libcurl4-openssl-dev libzstd-dev xz-utils libjson-c-dev

      - run: gcc bux-v1.c -o bux -larchive -lcurl -lzstd -lpthread -ljson-c

      - run: |
          mkdir -p alpine-root
          wget -qO alpine-minirootfs.tar.gz https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/x86_64/alpine-minirootfs-3.21.3-x86_64.tar.gz
          sudo tar -xzf alpine-minirootfs.tar.gz -C alpine-root
          rm alpine-minirootfs.tar.gz
          sudo cp /etc/resolv.conf alpine-root/etc/resolv.conf
          sudo cp bux alpine-root/tmp/
          sudo chroot alpine-root /bin/sh -c "
            apk add curl wpa_supplicant linux-virt openrc busybox-openrc build-base
            rc-update add networking boot
            cd /tmp
            wget -qO- https://oils.pub/download/oils-for-unix-0.37.0.tar.gz | tar -xz
            cd oils-for-unix-0.37.0 && ./configure && _build/oils.sh
            cp _bin/cxx-opt-sh/oils-for-unix /usr/local/bin/
            cd /tmp && rm -rf oils-for-unix-0.37.0
            gcc bux -o /usr/local/bin/bux -larchive -lcurl -lzstd -lpthread -ljson-c
            rm /tmp/bux
            apk del build-base
            adduser -D -s /usr/local/bin/oils-for-unix kinux
          "
          echo 'export PATH="/usr/local/bin:$PATH"' | sudo tee -a alpine-root/home/kinux/.profile
          sudo rm -rf alpine-root/var/cache/apk
          sudo mksquashfs alpine-root filesystem.squashfs -comp xz -noappend
          mkdir -p iso
          mv filesystem.squashfs iso/
          cp /usr/lib/ISOLINUX/isolinux.bin iso/
          cp /usr/lib/syslinux/modules/bios/ldlinux.c32 iso/
          printf 'DEFAULT linux\nLABEL linux\n  KERNEL /vmlinuz\n  APPEND initrd=/initrd.img boot=live toram console=tty0\n' > iso/isolinux.cfg
          sudo cp alpine-root/boot/vmlinuz-virt iso/vmlinuz
          sudo cp alpine-root/boot/initramfs-virt iso/initrd.img
          sudo chmod 644 iso/vmlinuz iso/initrd.img
          xorriso -as mkisofs -isohybrid-mbr /usr/lib/ISOLINUX/isohdpfx.bin -c boot.cat -b isolinux.bin -no-emul-boot -boot-load-size 4 -boot-info-table -o kinux.iso iso

      - uses: actions/upload-artifact@v4
        with:
          name: kinux-iso
          path: kinux.iso
